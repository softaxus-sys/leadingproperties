# Public URL of this site (canonical links, sitemap, Open Graph)
SITE_URL=https://leadingproperties.ae

# Listings come from Vrodux ERP (Real Estate → Website)
VRODUX_API_URL=https://erp.vrodux.com
# Generated in Vrodux ERP → Real Estate → Website. Server-side only: never prefix with NEXT_PUBLIC_.
VRODUX_API_KEY=
# Seconds to cache API responses before refetching
VRODUX_REVALIDATE_SECONDS=300

# Vrodux CRM inbound webhook for enquiry-form leads (ERP → Webhooks). Server-side only:
# the URL itself is the secret, never expose it to the browser or commit the real value.
VRODUX_LEAD_WEBHOOK_URL=
