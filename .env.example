# Public URL of this site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://leadingproperties.ae

# Where listings come from: "json" (src/data/properties.json) or "vrodux" (Vrodux Real Estate API)
LISTINGS_SOURCE=json

# Only used when LISTINGS_SOURCE=vrodux
VRODUX_API_URL=https://erp.vrodux.com
VRODUX_TENANT_SLUG=leading-properties
# Seconds to cache API responses before refetching
VRODUX_REVALIDATE_SECONDS=300
